// ===============================================================
// BENCHMARK SIMD & STRUCTURE OF ARRAYS (SoA) - PhasorLang
// Simulación física de 10,000 entidades en memoria contigua plana
// ===============================================================

// 1. Declaración de estructura física (SoA)
struct Particle {
    x: Float,
    y: Float,
    z: Float,
    vx: Float,
    vy: Float,
    vz: Float
}

// 2. Operaciones vectoriales con tipado gradual Vec3
v1: Vec3 = [10.0, 20.0, 30.0]
v2: Vec3 = [1.0, 2.0, 3.0]
v_sum = v1 + v2
producto_punto = dot(v1, v2)
magnitud_v1 = mag(v1)

out("Suma Vectorial v1 + v2:", v_sum)
out("Producto Punto dot(v1, v2):", producto_punto)
out("Magnitud mag(v1):", magnitud_v1)

// 3. Extracción de componentes ortogonales por miembro
componente_x = v_sum.x
componente_y = v_sum.y
componente_z = v_sum.z
out("Componentes de v_sum:", componente_x, componente_y, componente_z)

// 4. Reserva de memoria contigua plana (SoA) para 10,000 entidades
// 3 campos contiguos para Posicion (x, y, z) y 3 para Velocidad (vx, vy, vz)
N = 10000
dt = 0.016666

pos_soa = alloc_soa(3, N)
vel_soa = alloc_soa(3, N)

// Inicialización masiva contigua de velocidades: vx=1.5, vy=-9.81, vz=0.5
simd_init_vel(vel_soa, N, 1.5, -9.81, 0.5)

// 5. Bucle de integración física SIMD contigua (100 pasos de simulación = 60 FPS tiempo real)
pasos = 0
while (pasos < 100) {
    simd_step(pos_soa, vel_soa, N, dt)
    pasos = pasos + 1
}

// 6. Inspección de partículas testigo (índice 0 y 9999) tras 100 pasos
p0_x = get_soa(pos_soa, 0, 0, N)
p0_y = get_soa(pos_soa, 1, 0, N)
p0_z = get_soa(pos_soa, 2, 0, N)

pLast_x = get_soa(pos_soa, 0, 9999, N)
pLast_y = get_soa(pos_soa, 1, 9999, N)
pLast_z = get_soa(pos_soa, 2, 9999, N)

out("Simulacion SoA completada para 10,000 entidades (100 pasos)")
out("Particula 0 Posicion Final:", p0_x, p0_y, p0_z)
out("Particula 9999 Posicion Final:", pLast_x, pLast_y, pLast_z)
